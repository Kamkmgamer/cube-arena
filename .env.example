# Postgres connection for the app, as the limited `cube_app` role
# (Supabase transaction pooler, port 6543). scripts/set-app-password.mjs writes it.
CUBE_DATABASE_URL=postgres://cube_app.<project-ref>:<password>@<region>.pooler.supabase.com:6543/postgres

# Random secret used to hash IP addresses for rate limiting. Never stored raw.
CUBE_IP_SALT=

# Bearer token that puts a run on the Verified board. Only the operator has it.
CUBE_OPERATOR_TOKEN=

# Optional: the public URL, used in links the server hands to models.
# PUBLIC_BASE_URL=https://cube.krnl.studio
